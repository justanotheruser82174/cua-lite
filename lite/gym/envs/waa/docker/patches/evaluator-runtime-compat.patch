@@ -597,6 +597,26 @@ def get_active_url_from_accessTree(env, config):
         Return
             url: str
     """
+
+    # UI Automation can take several minutes to traverse a modern Chromium
+    # tree. A single inspectable page is unambiguously the active task page,
+    # so use the already-required CDP endpoint before falling back to UIA.
+    if env.vm_platform == "Windows":
+        try:
+            response = requests.get(
+                f"http://{env.vm_ip}:9222/json/list",
+                timeout=5,
+            )
+            response.raise_for_status()
+            pages = [
+                target for target in response.json()
+                if target.get("type") == "page"
+                and not target.get("url", "").startswith(("chrome://", "edge://"))
+            ]
+            if len(pages) == 1 and pages[0].get("url"):
+                return pages[0]["url"]
+        except Exception as e:
+            logger.warning("Unable to read the active URL through CDP: %s", e)
     
     # Determine the correct a11y backend & selector based on OS and system architecture
     selector = None
